NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-a-separate-long-random-secret

# Pix direto: QR gerado localmente e pagamento enviado para esta chave.
# O banco da loja nao oferece confirmacao automatica; confira o extrato antes de aprovar.
PIX_KEY=
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=

# Frete gratis em todo o Brasil. Para outra modalidade, escolha fixed ou correios.
SHIPPING_MODE=free
# Usado somente com SHIPPING_MODE=fixed (valor em centavos e prazo em dias uteis).
SHIPPING_FLAT_RATE_CENTS=
SHIPPING_FLAT_RATE_DAYS=

# Correios CWS: credenciais e servicos habilitados no seu contrato.
CORREIOS_USER=
CORREIOS_ACCESS_CODE=
CORREIOS_POSTAL_CARD=
CORREIOS_ORIGIN_CEP=
CORREIOS_SERVICE_CODES=03220,03298
CORREIOS_PACKAGE_LENGTH_CM=
CORREIOS_PACKAGE_WIDTH_CM=
CORREIOS_PACKAGE_HEIGHT_CM=
CORREIOS_ITEM_WEIGHT_GRAMS=
